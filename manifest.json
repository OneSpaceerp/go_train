{
  "name": "Go Train — Athlete & Coach",
  "short_name": "Go Train",
  "description": "Native-grade athlete & coach training, class booking, gym check-in, and PR tracking on ERPNext.",
  "start_url": "/gotrain?source=pwa",
  "display": "standalone",
  "background_color": "#0B0C10",
  "theme_color": "#FED14F",
  "lang": "en",
  "scope": "/gotrain",
  "id": "/gotrain",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "dir": "auto",
  "categories": [
    "fitness",
    "health",
    "sports",
    "lifestyle"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.gotrain.app",
      "url": "https://play.google.com/store/apps/details?id=com.gotrain.app"
    }
  ],
  "share_target": {
    "action": "/gotrain/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "video/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/gotrain/open-file",
      "accept": {
        "image/*": [
          ".jpg",
          ".jpeg",
          ".png",
          ".webp",
          ".gif",
          ".heic"
        ],
        "video/*": [
          ".mp4",
          ".mov",
          ".m4v",
          ".webm"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+gotrain",
      "url": "/gotrain/open?u=%s"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 420
  },
  "icons": [
    {
      "src": "/assets/go_train/images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/go_train/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/go_train/images/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/go_train/images/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/go_train/images/icon-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/go_train/images/screenshot-narrow.png",
      "sizes": "540x1170",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Go Train Today Session & Set-by-Set Workout Tracker"
    },
    {
      "src": "/assets/go_train/images/screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Go Train Athlete & Coach Dashboard"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's Workout",
      "short_name": "Train",
      "description": "Jump straight into your scheduled training session",
      "url": "/gotrain?source=shortcut-train",
      "icons": [
        {
          "src": "/assets/go_train/images/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Classes & Check-In",
      "short_name": "Classes",
      "description": "Book a class spot or check in on the gym floor",
      "url": "/gotrain/classes?source=shortcut-classes",
      "icons": [
        {
          "src": "/assets/go_train/images/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Log PR / Benchmark",
      "short_name": "Log PR",
      "description": "Record a new personal record or body metric",
      "url": "/gotrain/track?source=shortcut-track",
      "icons": [
        {
          "src": "/assets/go_train/images/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Workout History",
      "short_name": "History",
      "description": "Search past workout scores and notes",
      "url": "/gotrain/history?source=shortcut-history",
      "icons": [
        {
          "src": "/assets/go_train/images/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
